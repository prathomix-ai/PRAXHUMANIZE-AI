# --- Multi-Tier Waterfall & API Key Rotation Configuration ---

# Tier 1: Local Ollama Laptop (Cloudflare Tunnel URL or Local URL)
LOCAL_OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:latest

# Tier 2: Gemini API Key Rotation Array (Comma-separated 10 keys)
GEMINI_API_KEYS=key1,key2,key3,key4,key5,key6,key7,key8,key9,key10
GEMINI_MODEL=gemini-1.5-flash

# Tier 3: Groq API Key Rotation Array (Comma-separated 10 keys)
GROQ_API_KEYS=key1,key2,key3,key4,key5,key6,key7,key8,key9,key10
GROQ_MODEL=llama-3.3-70b-versatile

